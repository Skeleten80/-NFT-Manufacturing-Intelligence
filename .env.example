# Copy via python scripts/init_env.py; generated .env is ignored.
NFT_DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_VALUE
NFT_DB_RUNTIME_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
NFT_ENVIRONMENT=development
NFT_DATABASE_URL=postgresql+psycopg://nft_runtime:REPLACE_WITH_DIFFERENT_RANDOM_VALUE@postgres:5432/nft
NFT_MIGRATION_DATABASE_URL=postgresql+psycopg://nft_migrator:REPLACE_WITH_RANDOM_VALUE@postgres:5432/nft
NFT_REDIS_URL=redis://redis:6379/0
